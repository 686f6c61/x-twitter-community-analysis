# RapidAPI Configuration
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=twitter-api45.p.rapidapi.com

# TwitterAPI.io (future)
TWITTERAPI_KEY=your_twitterapi_key_here

# Server Configuration
PORT=3001
